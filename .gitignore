# Gitignore for IPTV-Custom-API.
# Secrets and live DNS stay on the machine that runs the monitor (usually the VPS).
# Playlists.yaml is rewritten on failover (current_dns) — never commit it.

tools/
logs/
.env
config/playlists.yaml
config/urls.yaml
config/player.yaml
config/watch_users.yaml
config/*.yaml.tmp
state/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
.DS_Store
Thumbs.db

# Android player
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
*.jks
*.keystore
*.apk
*.aab
