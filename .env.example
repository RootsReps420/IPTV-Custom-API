# Copy to .env and fill in. Never commit .env.

EPGENIUS_API_KEY=your-epgenius-api-key

# Private channel: playlist DNS swaps (includes usernames/passwords)
DISCORD_WEBHOOK_SWAPS=https://discord.com/api/webhooks/your-swap-webhook-id/your-swap-webhook-token

# Private channel: URL down/up and failover problems
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/your-alert-webhook-id/your-alert-webhook-token
