# Reverse-proxy the dashboard. App stays on 127.0.0.1:8787.
# Public site has no login. /owner and /api/status use the same Caddy user (dan)
# with a base64(bcrypt) hash — Ubuntu Caddy 2.6.2.
# Do not copy this file over /etc/caddy/Caddyfile blindly: keep the live hash.

vps-4f889186.vps.ovh.net {
	encode gzip
	@owner {
		path /owner /owner/ /api/status /api/switch /api/switch-back
	}
	basicauth @owner {
		dan REPLACE_WITH_BASE64_HASH
	}
	reverse_proxy 127.0.0.1:8787
}
