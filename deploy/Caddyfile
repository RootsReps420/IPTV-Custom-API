# Reverse proxy for the Python app on 127.0.0.1:8787.
#
# No logins here: the app does them.
#   Dashboard: sign-in page at / (dash_auth.py, config/dashboard_users.yaml) —
#   owner = everything, viewer = / and /history. Unknown paths are owner-only.
#   Watch: its own site login (/watch, /api/watch/*, /api/player/*).
# Do not add basicauth back for dashboard paths, or people get two password prompts.
#
# Do not gzip `/api/player/*` (live MPEG-TS / HLS). Copying this over /etc/caddy/Caddyfile:
# keep the live hostname; validate, then `systemctl restart caddy` (not reload).

vps-4f889186.vps.ovh.net {
	# Live streams are already compressed video; gzip would buffer and stall playback.
	@notplayer {
		not path /api/player /api/player/*
	}
	encode @notplayer gzip
	# flush_interval -1: stream MPEG-TS to the browser without waiting for full responses.
	# Catalogue JSON from this panel can take ~60s; default upstream timeout is too short.
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
		transport http {
			dial_timeout 10s
			read_timeout 24h
			write_timeout 24h
		}
	}
}
