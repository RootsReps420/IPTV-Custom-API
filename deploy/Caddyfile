# Reverse proxy for the Python app on 127.0.0.1:8787.
#
# Public: `/` `/history` `/watch` `/api/public` `/api/history` `/static`
# /watch login is IN THE APP (cookie), not Caddy.
# Owner: `/owner` `/api/status` `/api/switch*` — basicauth user `dan`.
#
# Do not gzip `/api/player/*` (live MPEG-TS / HLS). Do not copy this file over
# /etc/caddy/Caddyfile blindly: keep the live bcrypt hash.

vps-4f889186.vps.ovh.net {
	# Live streams are already compressed video; gzip would buffer and stall playback.
	@notplayer {
		not path /api/player /api/player/*
	}
	encode @notplayer gzip
	@owner {
		path /owner /owner/ /api/status /api/switch /api/switch-back
	}
	basicauth @owner {
		dan REPLACE_WITH_BASE64_HASH
	}
	# flush_interval -1: stream MPEG-TS to the browser without waiting for full responses.
	# Catalogue JSON from this panel can take ~60s; default upstream timeout is too short.
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
		transport http {
			dial_timeout 10s
			read_timeout 120s
			write_timeout 120s
		}
	}
}
