# systemd unit for the IPTV monitor + dashboard + /watch player.
# WorkingDirectory must be the app root so config/ and .env resolve.
# Restart=always: process crash or VPS reboot brings it back.
# Do not also run the Windows IPTVPortalMonitor task.

[Unit]
Description=IPTV portal monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/iptv-monitor
ExecStart=/home/ubuntu/iptv-monitor/.venv/bin/python /home/ubuntu/iptv-monitor/main.py
Restart=always
RestartSec=5
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
